# Copy this file to .env and fill in ONE provider.
# With no key at all the app runs in demo mode (canned result) so you can try the UI.

# --- Option A (recommended): Google Gemini, free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "gemini-flash-latest" always points at Google's current Flash model.
# Use "gemini-flash-lite-latest" for a bigger free daily quota (slightly less accurate).
GEMINI_MODEL=gemini-flash-latest

# --- Option B: any OpenAI-compatible vision API (OpenRouter, Groq, OpenAI...)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemma-4-31b-it:free

# Force a provider: gemini | openai | demo (auto-detected from the keys above if unset)
# AI_PROVIDER=

PORT=3000
# Max analyses per visitor IP per minute (protects the free quota)
RATE_LIMIT_PER_MIN=6
